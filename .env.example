# 复制为 .env 后填写：cp .env.example .env

# --- 镜像 ---
# 填入你的 Docker Hub 账号（或改用 ghcr.io/OWNER/tjsocks:latest）
TJSOCKS_IMAGE=docker.io/sitdownkevin/tjsocks:latest

# --- 校园 VPN 凭证（必填）---
TJ_USER=2610114
TJ_PASSWORD=change-me

# --- VPN 网关（一般不用改）---
# TJ_AUTH_METHOD=LDAP3
# TJ_GATEWAY=vpn.tongji.cn
# 服务器 DNS 解析不了 vpn.tongji.cn 时，直接指定 IP:端口
# TJ_GATEWAY_ADDRESS=202.120.189.34:443

# --- SOCKS5 服务 ---
# 宿主机监听端口（容器内固定 1080，TCP 与 UDP 同时映射）
SOCKS_PORT=1080

# SOCKS5 代理认证：公网部署务必设置
SOCKS_USER=proxyuser
SOCKS_PASS=changeme

# 日志级别：debug / info / warn / error
TJ_LOG_LEVEL=info

# 容器内监听地址，一般不用改
# SOCKS_LISTEN=0.0.0.0:1080
# SOCKS_UDP_LISTEN=0.0.0.0:1080

# 返回给客户端的 UDP 中继地址。留空 = 0.0.0.0:<端口>，
# Clash / mihomo / sing-box 会自动替换成代理服务器地址。
# 若客户端不认 0.0.0.0，填公网地址，例如：
# SOCKS_UDP_ADVERTISE=203.0.113.10:1080
